# Android
android/

# Node
node_modules/
*.log
.nvm
package-lock.json

# Web portal (web/) — build output. The bare `package-lock.json` rule above
# matches at any depth, so the portal's lockfile has to be re-included
# explicitly: it is a deployed artifact and its build must be reproducible.
web/dist/
!web/package-lock.json

# iOS / CocoaPods
ios/

# Visual Studio Code (config dir - if present, this merges user defined
# workspace settings on top of react-native.code-workspace)
/.vscode
.vscode/
.vscode
.vs
*.swp

# Expo generated files
.expo/

# Google service files
google-services.json
GoogleService-Info.plist

# Environment variables
.env
.env.*

# ...except two portal env files that carry no secrets, and must be committed:
#   .env.example     how a new checkout learns which VITE_* vars exist
#   .env.production  the database opt-in, which decides whether a deploy points
#                    at real data. Losing it means the next deploy silently
#                    ships a portal wired to the test database.
# These negations must come AFTER `.env.*` above: gitignore resolves by last
# match, not most specific.
!web/.env.example
!web/.env.production

# Firebase admin credentials — NEVER commit these
service-account.json
**/service-account.json
*-service-account.json

# Migration tooling output
tools/migration/reports/

# macOS
.DS_Store

# Firebase CLI deploy cache (hashes of uploaded files)
.firebase/

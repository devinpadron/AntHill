rules_version = '2';

// INTERIM RULES — v1 (PascalCase) schema.
//
// Replaces the previous allow-all ruleset (see firestore.rules.v1.backup),
// which exposed the entire database to unauthenticated readers and let any
// signed-in account write any document.
//
// This is a stopgap shaped to the CURRENT collection layout so it can ship
// ahead of the v2 re-model. Known limitations, all fixed by the v2 rules:
//   - Any signed-in user can read any Users/{uid} doc and any Companies/{cid}
//     doc. Scoping those to "shares a company with me" needs the denormalized
//     membership records that v2 introduces; doing it here would require a
//     get() against `Users.companies`, whose shape is unreliable in legacy
//     data (it may still be a map rather than an array).
//   - Membership is checked with exists()/get() on Companies/{cid}/Users/{uid},
//     which bills one extra document read per request.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function membership(companyId) {
      return /databases/$(database)/documents/Companies/$(companyId)/Users/$(request.auth.uid);
    }

    function isMember(companyId) {
      return isSignedIn() && exists(membership(companyId));
    }

    // NOTE: the capitalized variants are deliberate. src/utils/dbMigrationUtils.ts
    // was supposed to normalize "Owner"/"Admin" to "owner"/"manager" but is dead
    // code (checkAndRunMigrations has no callers), so legacy role values are
    // still live. Dropping them here would lock existing admins out.
    function isManager(companyId) {
      return isMember(companyId)
        && get(membership(companyId)).data.role in
             ["owner", "manager", "Owner", "Admin", "Manager"];
    }

    // ---- Public, pre-auth reads --------------------------------------------
    // Both are read before sign-in by the launch gate (src/hooks/useAppGate.ts).
    // They contain no user data.

    match /AppData/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /appConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Users -------------------------------------------------------------

    match /Users/{userId} {
      // Member lists, event assignment and payroll all read other users'
      // profiles directly (userService.batchGetUsers and friends).
      allow read: if isSignedIn();
      allow create, update, delete: if isSelf(userId);

      match /Preferences/{docId} {
        allow read, write: if isSelf(userId);
      }
    }

    // ---- Companies ---------------------------------------------------------

    match /Companies/{companyId} {
      /*
       * Was `if true` while 1.0.98 was the released build: its signup queried
       * this collection by accessCode BEFORE creating the auth account, so
       * requiring auth would have broken signup for every live user. 1.0.100
       * reordered that flow to authenticate first.
       *
       * Tightened ahead of full 1.0.100 adoption, deliberately. Existing
       * signed-in users on older builds are unaffected — they are
       * authenticated, so their reads still pass. The only thing this breaks
       * is a NEW signup from a pre-1.0.100 build, which now fails with
       * "Invalid Access Code" until that phone updates.
       *
       * That is a far smaller cost than the alternative: an access code is a
       * shared secret that lets someone join a company, and public read meant
       * anyone could enumerate every company and harvest one without holding
       * an account at all.
       */
      allow read: if isSignedIn();
      // Companies are provisioned out of band; the app never writes them.
      allow write: if false;

      match /Users/{userId} {
        allow read: if isMember(companyId);
        // Joining a company: you may create only your own membership, and only
        // as a plain user. This is the privilege-escalation guard.
        allow create: if isSelf(userId)
                      && request.resource.data.role == "user";
        allow update: if isManager(companyId);
        allow delete: if isManager(companyId) || isSelf(userId);
      }

      // Legacy collection — a conditional phone write in useProfile.ts is its
      // only remaining reference. Not migrated to v2.
      match /Employees/{userId} {
        allow read: if isMember(companyId);
        allow write: if isSelf(userId);
      }

      match /Settings/{docId} {
        allow read: if isMember(companyId);
        allow write: if isManager(companyId);
      }

      // Workers write to events too: availabilityService records confirm/decline
      // into the event's workerStatus map, and useEventDetails saves userNotes.
      match /Events/{eventId} {
        allow read, write: if isMember(companyId);

        match /{document=**} {
          allow read, write: if isMember(companyId);
        }
      }

      match /TimeEntries/{entryId} {
        allow read, write: if isMember(companyId);

        match /{document=**} {
          allow read, write: if isMember(companyId);
        }
      }

      // Admin-authored company config. Only the screens under
      // src/screens/settings/admin/ write these.
      match /Packages/{packageId} {
        allow read: if isMember(companyId);
        allow write: if isManager(companyId);
      }

      match /Checklists/{checklistId} {
        allow read: if isMember(companyId);
        allow write: if isManager(companyId);
      }

      match /EventLabels/{labelId} {
        allow read: if isMember(companyId);
        allow write: if isManager(companyId);
      }
    }

    // =====================================================================
    // v2 SCHEMA — flat, lowerCamel collections.
    //
    // Added ADDITIVELY: every v1 block above is untouched, so the running v1
    // app is unaffected and v1 remains the rollback target.
    //
    // The scoping mechanism is different from v1 and is the main reason the
    // flattening is safe. Membership is decided by `resource.data.companyId`
    // rather than by the document's position in the tree, and because Firestore
    // rules are NOT filters, a query that does not carry
    // `where("companyId","==",...)` is rejected outright. The client physically
    // cannot issue an unscoped query — it is enforced, not conventional.
    // =====================================================================

    function v2Membership(companyId) {
      return /databases/$(database)/documents/memberships/$(companyId + "_" + request.auth.uid);
    }

    function v2IsMember(companyId) {
      return isSignedIn()
        && exists(v2Membership(companyId))
        && get(v2Membership(companyId)).data.status == "active";
    }

    /** Membership derived from a time entry's parent document. */
    function v2IsMemberOfEntry(entryId) {
      return isSignedIn()
        && v2IsMember(
             get(/databases/$(database)/documents/timeEntries/$(entryId)).data.companyId
           );
    }

    function v2IsManagerOfEntry(entryId) {
      return isSignedIn()
        && v2IsManager(
             get(/databases/$(database)/documents/timeEntries/$(entryId)).data.companyId
           );
    }

    function v2IsManager(companyId) {
      return v2IsMember(companyId)
        && get(v2Membership(companyId)).data.role in ["owner", "manager"];
    }

    /*
     * A join that carries a group assignment, backed by that group's code.
     *
     * The joiner writes the code they used onto their own membership, and this
     * checks it against groupJoinCodes/{code} — which they could only have
     * addressed by knowing it. So a joiner can land in the group whose code
     * they were given, and no other.
     *
     * This is the ONLY path that may set groupIds or visibility on a create,
     * and it is safe for existing members because create applies solely to a
     * document that does not yet exist. Removal is a status change rather than
     * a delete, so a current or former member can never take this path again;
     * changing your own groups still requires update, which is manager-only.
     */
    function v2JoinedViaValidCode() {
      let used = request.resource.data.get("joinedViaCode", "");
      let ref = /databases/$(database)/documents/groupJoinCodes/$(used);
      return used != ""
        && exists(ref)
        && get(ref).data.companyId == request.resource.data.companyId
        && request.resource.data.get("groupIds", []) == [get(ref).data.groupId]
        && request.resource.data.get("visibility", "open") == get(ref).data.visibility;
    }

    /*
     * An event nobody was specifically invited to, i.e. open to the company.
     *
     * Defaults to open when the field is absent: reading a missing map key
     * raises an error in rules, which would deny rather than fall through, and
     * "no audience recorded" means the same thing as "everyone" everywhere else
     * in the schema.
     */
    function v2EventIsOpen(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId))
               .data.get("isTargeted", false) != true;
    }

    // ---- identity --------------------------------------------------------

    // Self only. v1 had to expose every profile because member lists were built
    // by fanning out over Users; v2 denormalizes name/email/phone onto
    // memberships, so nothing needs to read another user's profile document.
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /userSettings/{userId} {
      allow read, write: if isSelf(userId);
    }

    match /companies/{companyId} {
      // Joining by access code queries this collection before membership
      // exists, so any signed-in user may read a company document.
      allow read: if isSignedIn();
      // Companies are provisioned out of band.
      allow write: if false;
    }

    match /companyPreferences/{companyId} {
      allow read: if v2IsMember(companyId);
      allow write: if v2IsManager(companyId);
    }

    match /memberships/{membershipId} {
      /*
       * Two ways to read a membership:
       *   - it is YOURS, which is how the profile screen finds every company
       *     you belong to (a query filtered on userId, with no companyId to
       *     scope by); or
       *   - you are an active member of the company it belongs to, which is
       *     how member lists work.
       *
       * The first clause is not redundant. Scoping by company alone forces a
       * cross-company query to satisfy a per-company predicate, which Firestore
       * cannot prove and therefore rejects outright.
       */
      /*
       * `get` has to tolerate a document that is not there yet.
       *
       * joinCompanyWithAccessCode opens a transaction that reads
       * memberships/{companyId}_{userId} to see whether one already exists. On
       * a FIRST join it does not, so `resource` is null and a condition
       * phrased in terms of resource.data has nothing to evaluate — which
       * denies rather than returning "not found". That failed every first
       * join, signup included, with permission-denied.
       *
       * Reading a document that does not exist reveals only that it does not
       * exist, and you must already know both the company id and the user id
       * to ask. `list` keeps the strict form: absent documents never appear in
       * a query, so it has nothing to tolerate.
       */
      allow get: if resource == null
                 || isSelf(resource.data.userId)
                 || v2IsMember(resource.data.companyId);
      allow list: if isSelf(resource.data.userId)
                  || v2IsMember(resource.data.companyId);
      // Joining: only your own membership, only as a plain user, and the id
      // must be the canonical composite so it cannot collide with someone
      // else's. This is the privilege-escalation guard.
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && membershipId == request.resource.data.companyId + "_" + uid()
                    && request.resource.data.role == "user"
                    && request.resource.data.status == "active"
                    // Joining may only place you in a group if you presented
                    // that group's join code. See v2JoinedViaValidCode.
                    //
                    // Read with defaults: a missing key raises an error in
                    // rules, which DENIES rather than falling through, so
                    // reading these directly would reject every join issued by
                    // a client that does not send them.
                    && (
                      (request.resource.data.get("visibility", "open") == "open"
                       && request.resource.data.get("groupIds", []) == [])
                      || v2JoinedViaValidCode()
                    );
      allow update: if v2IsManager(resource.data.companyId)
                    // A member may keep their own denormalized profile fresh
                    // and choose which pushes they get, but never their own
                    // role, status, visibility or groups. hasOnly is what
                    // enforces that: the segmentation fields are absent from
                    // this list, so a worker cannot widen their own access.
                    //
                    // `notifications` is a preference, not a permission —
                    // muting yourself grants nothing. It lives here rather than
                    // on userSettings so a manager can see who has gone quiet,
                    // which reading userSettings would not allow.
                    || (isSelf(resource.data.userId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(["firstName","lastName","email","phone","notifications","updatedAt"]));
      allow delete: if false;   // removal is a status change, not a delete
    }

    // Named sets of workers a manager publishes events to. Membership is a
    // field on the membership document, not a roster here.
    match /groups/{groupId} {
      allow read: if v2IsMember(resource.data.companyId);
      allow create: if v2IsManager(request.resource.data.companyId);
      allow update, delete: if v2IsManager(resource.data.companyId);
    }

    /*
     * Group join codes. THE DOCUMENT ID IS THE CODE.
     *
     * `get` is open to any signed-in user because addressing the document
     * already requires knowing the code — that is the credential. `list` is
     * denied, so the collection cannot be enumerated and codes cannot be
     * harvested. This is the same trust model as the company access code,
     * which is likewise a shared secret that lets a stranger in.
     */
    match /groupJoinCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      /*
       * Create, update and delete are split, and the split is the point.
       *
       * Sharing one clause let a manager of company A write a document at an id
       * already owned by company B: the check passed on the companyId they
       * were WRITING rather than the one already there, so B's code silently
       * became A's. Since the id is the code itself, that is a code takeover,
       * and setGroupJoinCode issues a set() which overwrites.
       *
       * Create cannot overwrite — Firestore only evaluates it when the
       * document does not exist — so a random collision now fails loudly
       * instead of stealing someone else's code. Update requires owning what
       * is already there and forbids moving it to another company.
       */
      allow create: if v2IsManager(request.resource.data.companyId);
      allow update: if v2IsManager(resource.data.companyId)
                    && request.resource.data.companyId == resource.data.companyId;
      allow delete: if v2IsManager(resource.data.companyId);
    }

    // ---- company library -------------------------------------------------

    // Immutable once written: editing a form publishes a NEW schema and
    // repoints the preference. Enforced here so a future bug cannot rewrite
    // history that historical time entries still reference.
    match /formSchemas/{schemaId} {
      allow read: if v2IsMember(resource.data.companyId);
      allow create: if v2IsManager(request.resource.data.companyId);
      allow update, delete: if false;
    }

    match /packages/{packageId} {
      allow read: if v2IsMember(resource.data.companyId);
      allow create: if v2IsManager(request.resource.data.companyId);
      allow update, delete: if v2IsManager(resource.data.companyId);
    }

    match /checklists/{checklistId} {
      allow read: if v2IsMember(resource.data.companyId);
      allow create: if v2IsManager(request.resource.data.companyId);
      allow update, delete: if v2IsManager(resource.data.companyId);
    }

    match /eventLabels/{labelId} {
      allow read: if v2IsMember(resource.data.companyId);
      allow create: if v2IsManager(request.resource.data.companyId);
      allow update, delete: if v2IsManager(resource.data.companyId);
    }

    // ---- events ----------------------------------------------------------

    match /events/{eventId} {
      /*
       * Single-document reads are checked against the audience: a targeted
       * event can only be fetched by a manager, someone assigned to it, or
       * someone holding an invitation.
       *
       * `list` is deliberately NOT narrowed the same way. Firestore evaluates a
       * list query against its potential result set, so a per-caller audience
       * predicate cannot be expressed without rejecting the query outright —
       * the same mechanic behind the permission bugs this migration fixed.
       * Narrowing list would have to deny it to restricted members entirely,
       * which would break their own calendar, since that is a list query too.
       *
       * So the honest boundary: responding is enforced (below), and fetching a
       * targeted event by id is enforced here, but a restricted member issuing
       * a raw list query could still enumerate event titles and dates for their
       * own company. The app never shows them; the exposure is via direct API
       * access, not the product.
       */
      allow get: if resource == null
                 || v2IsManager(resource.data.companyId)
                 || (v2IsMember(resource.data.companyId)
                     && (resource.data.get("isTargeted", false) != true
                         || uid() in resource.data.get("assignedUserIds", [])
                         || exists(/databases/$(database)/documents/eventResponses/$(eventId + "_" + uid()))));
      allow list: if v2IsMember(resource.data.companyId);
      allow create: if v2IsManager(request.resource.data.companyId);
      allow update: if v2IsManager(resource.data.companyId)
                    // A worker may edit their own notes on an event and
                    // nothing else. In v1 this same action wrote the entire
                    // event document back, clobbering concurrent admin edits.
                    || (v2IsMember(resource.data.companyId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(["workerNotes","updatedAt","updatedBy"]));
      allow delete: if v2IsManager(resource.data.companyId);
    }

    // One document per (event, user).
    //
    // This is why responses are separate documents rather than a map on the
    // event: rules can only diff TOP-LEVEL keys, so with an embedded
    // workerStatus map every worker would need write access to the whole map —
    // i.e. the ability to confirm or decline on a colleague's behalf.
    match /eventResponses/{responseId} {
      allow read: if v2IsMember(resource.data.companyId);

      /*
       * Create and update are split, and that split is what makes worker
       * groups real rather than decorative.
       *
       * A manager creates responses as INVITATIONS when publishing an event to
       * a group. A worker may create their own only for an event that is open
       * to everyone. Without the distinction a restricted worker could simply
       * write their own response document for a targeted event and opt
       * themselves in — the group would be a suggestion, not a boundary.
       */
      allow create: if responseId == request.resource.data.eventId + "_" + request.resource.data.userId
                    && (v2IsManager(request.resource.data.companyId)
                        || (v2IsMember(request.resource.data.companyId)
                            && request.resource.data.userId == uid()
                            && v2EventIsOpen(request.resource.data.eventId)));

      /*
       * A worker writes their own reply and nothing else — not whose response
       * it is, not which event it belongs to.
       *
       * The key list covers TWO separate answers on one document:
       *   status / respondedAt   "can you work this?"
       *   acknowledgedAt         "I see I am working this"
       * A worker may write either; both are theirs to state.
       *
       * `problemFlaggedAt` and `problemNote` are gone. A worker could once say
       * they could not make a shift they were already on, which raised a flag
       * without unassigning them; the feature is removed, and leaving the keys
       * writable would let a client keep setting fields nothing reads.
       *
       * `id`, `companyId`, `eventId` and `userId` are deliberately absent, so
       * a worker cannot re-point their own response at another event or
       * person. The acknowledgement writes send them via mergeFields, which is
       * a no-op when the document already exists — the values are unchanged,
       * so they never appear in affectedKeys().
       */
      allow update: if v2IsManager(resource.data.companyId)
                    || (isSelf(resource.data.userId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(["status","respondedAt","updatedAt",
                                       "dateKey","acknowledgedAt"]));

      allow delete: if v2IsManager(resource.data.companyId);
    }

    match /eventChecklistStates/{eventId} {
      /*
       * This document is created by the FIRST tick, so opening the checklist
       * on a fresh event reads one that is not there. See the note on
       * memberships: a rule phrased in terms of resource.data has nothing to
       * evaluate when resource is null, and denies instead of returning "not
       * found". `list` stays strict — absent documents never appear in a
       * query.
       */
      allow get: if resource == null
                 || v2IsMember(resource.data.companyId);
      allow list: if v2IsMember(resource.data.companyId);
      // Any member ticks items; concurrent workers no longer clobber each
      // other because writes are per-item field paths, not whole-map sets.
      allow create: if v2IsMember(request.resource.data.companyId);
      allow update: if v2IsMember(resource.data.companyId);
      allow delete: if v2IsManager(resource.data.companyId);
    }

    // ---- time entries ----------------------------------------------------

    match /timeEntries/{entryId} {
      allow get: if resource == null
                 || v2IsMember(resource.data.companyId);
      allow list: if v2IsMember(resource.data.companyId);
      allow create: if v2IsMember(request.resource.data.companyId)
                    && request.resource.data.userId == uid();
      // Owners edit their own entry; managers review anyone's.
      allow update: if v2IsManager(resource.data.companyId)
                    || isSelf(resource.data.userId);
      allow delete: if v2IsManager(resource.data.companyId);

      /*
       * Subcollections are authorized via their PARENT entry, not their own
       * companyId field.
       *
       * Firestore evaluates a LIST query against its potential result set, not
       * the documents actually returned — so a rule reading
       * `resource.data.companyId` can only be satisfied when the query itself
       * constrains companyId. These are always read as "every edit for THIS
       * entry", with no such filter, so that form rejected them outright.
       *
       * Reading the parent instead is both statically evaluable and more
       * honest: a subcollection's access should follow its parent's.
       */
      match /connections/{connectionId} {
        allow read: if v2IsMemberOfEntry(entryId);
        allow write: if v2IsMemberOfEntry(entryId);
      }

      /*
       * Append-only audit trail: an edit record can never be REWRITTEN.
       *
       * Deletion is allowed for managers, and only because deleting a time
       * entry has to remove its trail too — v1 left subcollections orphaned
       * when their parent was deleted, and an audit record for an entry that
       * no longer exists explains nothing while still costing storage.
       * Rewriting history stays impossible for everyone.
       */
      match /edits/{editId} {
        allow read: if v2IsMemberOfEntry(entryId);
        allow create: if v2IsMemberOfEntry(entryId);
        allow update: if false;
        allow delete: if v2IsManagerOfEntry(entryId);
      }
    }

    match /attachments/{attachmentId} {
      allow read: if v2IsMember(resource.data.companyId);
      allow create: if v2IsMember(request.resource.data.companyId);
      allow update: if v2IsManager(resource.data.companyId)
                    || isSelf(resource.data.ownerUserId);
      allow delete: if v2IsManager(resource.data.companyId)
                    || isSelf(resource.data.ownerUserId);
    }
  }
}

# Copy to .env.local and fill from:
#   firebase apps:sdkconfig WEB --project anthill-51de0
#
# These values are public by design — a web Firebase config ships to every
# browser. Access is controlled by firestore.rules, not by hiding them.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=anthill-51de0.firebaseapp.com
VITE_FB_PROJECT_ID=anthill-51de0
VITE_FB_STORAGE_BUCKET=anthill-51de0.firebasestorage.app
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# Which Firestore database to talk to.
#   test    (default) — the separate "test" database, same as a mobile dev build
#   default           — PRODUCTION "(default)"
# Anything other than "default" means test. An unconfigured build must never
# reach production data.
VITE_ANTHILL_DB=test

# Maps JavaScript API key for event-location autocomplete.
# MUST be a separate key from the mobile GOOGLE_PLACES_API_KEY, restricted by
# HTTP referrer to portal.anthillapp.com/* and localhost:5173/*.
VITE_GOOGLE_MAPS_KEY=

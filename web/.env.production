# Applied by `vite build` (mode "production"), on top of .env.local.
#
# THE ONLY THING THIS FILE SETS is which Firestore database the deployed portal
# talks to. Everything else — the Firebase config, the Maps key — comes from
# .env.local, which is gitignored, so no key is committed here.
#
# "default" means the PRODUCTION database. The default everywhere else is
# "test", deliberately: an unconfigured build must never reach real data. This
# is the one file that opts in.
VITE_ANTHILL_DB=default

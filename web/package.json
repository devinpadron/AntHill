{
	"name": "anthill-portal",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build && node scripts/check-single-react.mjs",
		"build:staging": "tsc --noEmit && vite build --mode staging && node scripts/check-single-react.mjs",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"deploy:staging": "npm run build:staging && firebase hosting:channel:deploy staging --only portal --expires 7d --project anthill-51de0",
		"deploy:live": "npm run build && firebase deploy --only hosting:portal --project anthill-51de0",
		"check:singletons": "node scripts/check-single-react.mjs"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.13.12",
		"date-fns": "^4.1.0",
		"firebase": "12.10.0",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-router-dom": "^7.9.3"
	},
	"devDependencies": {
		"@types/react": "~19.1.10",
		"@types/react-dom": "~19.1.9",
		"@vitejs/plugin-react": "^5.0.4",
		"ionicons": "^8.1.0",
		"typescript": "^5.9.2",
		"vite": "^7.1.9"
	}
}
